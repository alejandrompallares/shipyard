{
  "permissions": {
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(docker:*)",
      "Bash(git push:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(npx vercel deploy --prod:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
